<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF202020">

    <SurfaceView
        android:id="@+id/test_pattern_output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/test_pattern_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:background="#FF101010" />

    <LinearLayout
        android:id="@+id/test_pattern_speed_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#FF1A1A1A">

        <TextView
            android:id="@+id/test_pattern_speed_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FF00FF41"
            android:textSize="14sp"
            android:text="Scroll: 400 px/sec" />

        <SeekBar
            android:id="@+id/test_pattern_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2000" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#FF1A1A1A">

        <LinearLayout
            android:id="@+id/test_pattern_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#FF101010">

        <LinearLayout
            android:id="@+id/test_pattern_toggles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp" />
    </HorizontalScrollView>
</LinearLayout>
